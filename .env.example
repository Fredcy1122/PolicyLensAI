# LLM provider (configure only the provider you use)
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Embeddings
EMBEDDING_MODEL=

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Storage
CHROMA_PERSIST_DIRECTORY=./data/chroma
METADATA_DATABASE_URL=sqlite:///./data/policylens.db
